{
  "name": "@lycheelink/dsh-workbench",
  "description": "Enterprise Agent Workbench: scene-card grid with dynamic parameter forms, session launch, and control room monitoring for DSH Web UI",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lycheelink/dsh-workbench.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./typert": {
      "default": "./lib/typert.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "default": "./lib/remote.js"
    },
    "./descriptors": {
      "default": "./lib/descriptors.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "test",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:host && npm run build:client",
    "prepack": "npm run build",
    "test": "node test/smoke.mjs && node test/rc-verify.mjs",
    "test:rc": "node test/rc-verify.mjs",
    "setup:rc": "npm install --prefix .rc-verify/vendor --legacy-peer-deps",
    "install:dev": "node scripts/install-dev.mjs",
    "sync:artifact": "node scripts/sync-artifact.mjs",
    "pack:release": "npm run build && node scripts/package-release.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}